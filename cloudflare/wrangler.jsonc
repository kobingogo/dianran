{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dianran-local-preview",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/prompt-sources", "/prompt-sources/*", "/api", "/api/*"]
  },
  "vars": {
    "PROMPT_SNAPSHOT": "REPLACE_WITH_40_CHARACTER_COMMIT_SHA"
  },
  "r2_buckets": [
    {
      "binding": "PROMPTS",
      "bucket_name": "REPLACE_WITH_APPROVED_PREVIEW_BUCKET"
    }
  ]
}
