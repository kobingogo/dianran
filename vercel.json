{
  "framework": "vite",
  "installCommand": "cd web && bun install && cd ../api && bun install",
  "buildCommand": "cd web && bun run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    { "source": "/prompt-sources/:path*", "destination": "https://dianran-prompts.vercel.app/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
