{
  "framework": "vite",
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/prompt-sources/:path*", "destination": "https://dianran-prompts.vercel.app/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
